PORT=3000

# SMTP configuration for email notifications (e.g. Gmail)
# For Gmail, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (or 465)
# SMTP_USER is your Gmail address, SMTP_PASS is a Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# The email address that will receive the contact messages
RECEIVER_EMAIL=amitpvt0150@gmail.com
